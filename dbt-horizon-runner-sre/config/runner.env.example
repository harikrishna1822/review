# dbt-horizon runner configuration. Copy to runner.env and fill in. Never commit the filled copy.
# docker run --rm --env-file docker/runner/runner.env dbt-horizon-runner
# On ECS Fargate, put the plain values in the task definition's "environment" and the three
# secrets in Secrets Manager ("secrets"): see docs/runner.md.
# Format: KEY=value, no quotes, no spaces around "=" (docker passes quotes through literally).

# -- the repo: the branch `dbt-horizon export` pushed ------------------------------------------
RUNNER_REPO_URL=https://github.com/harikrishna1822/dbt-demo.git
RUNNER_REPO_REF=dbt-horizon/duckdb-test
RUNNER_PROJECT_DIR=retail_analytics_dbt
# private repo: a fine-grained token with Contents: read-only on this repo
GIT_TOKEN=<github token>

# -- Snowflake (Horizon Iceberg REST catalog) ----------------------------------------------------
# PAT of the reader role (DUCKDB_READER): reads the source Iceberg tables
DBT_HORIZON_READER_PAT=<reader PAT>
# PAT of the writer role (DBT_DUCKDB_WRITER): writes the models as Iceberg tables
DBT_HORIZON_WRITER_PAT=<writer PAT>

# -- what runs -----------------------------------------------------------------------------------
RUNNER_COMMAND=build
RUNNER_TARGET=horizon_write
RUNNER_SELECTOR=dbt_horizon
# RUNNER_SELECT=stg_orders+            # instead of the selector
# RUNNER_ARGS=--full-refresh
# 0: run once, exit with dbt's code (scheduled task); 900: pull and run every 15 minutes (service)
RUNNER_INTERVAL=0
# DBT_LOG_FORMAT=json               # dbt's own setting: JSON logs for CloudWatch
