# dbt-horizon deploy settings: $DBT_HORIZON_HOME/deploy.env (read by run.sh / cleanup.sh).
# No secrets here: those go in secrets/<name>.env.

# Notify on failed runs (Slack incoming webhook or any endpoint taking {"text": "..."}).
# NOTIFY_WEBHOOK=https://hooks.slack.com/services/...
# NOTIFY_ON=failure                 # failure | always

# Retention (cleanup.sh)
KEEP_WORKSPACE_DAYS=14
KEEP_LOG_DAYS=30
