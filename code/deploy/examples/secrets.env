# secrets/<name>.env for one deployment. Owner only: chmod 600 (Linux) / install.ps1 sets the ACL (Windows).
# The names are the ones the config refers to (pat_env, token_env).
SNOWFLAKE_PAT=<reader PAT>
SNOWFLAKE_WRITE_PAT=<writer PAT>
# private dbt repo: read-only token (GitHub fine-grained token, "Contents: read" on that repo)
GITHUB_TOKEN=<git token>
